# Build output, for both the workspace and the UI's separate cargo project.
**/target

# Trunk's output. It is embedded into the binary at compile time but is still a
# build artefact -- the server's build script creates the directory, so a fresh
# clone compiles without it being present.
/ui/dist

# Local configuration and data, neither of which belongs in the repository.
/config.toml
*.sqlite
*.sqlite-wal
*.sqlite-shm
.env

# rustfmt backups
**/*.rs.bk
